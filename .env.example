# ── QuizTime environment variables ──────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local

# Postgres connection string — REQUIRED (build fails without it)
# e.g. a Vercel Postgres / Neon / local database
DATABASE_URL=postgresql://user:password@localhost:5432/quiztime

# DEMO_LOGIN=1 enables a "Try it as a demo student" button on the login
# page that signs in a local test account (no Google OAuth needed).
# Dev/preview only — leave unset in production.
# DEMO_LOGIN=

# Google Gemini API key — required to generate flashcards, UNLESS you
# configure OPENROUTER_API_KEY instead (the app works with either, and with
# both it has the longest safety net).
# Get one free at https://aistudio.google.com
GEMINI_API_KEY=

# OpenRouter API key — optional but recommended as a second safety net.
# When EVERY Gemini model is at its limit, QuizTime falls back to OpenRouter's
# free models, so a Gemini daily-limit day never takes the app offline.
# Get one free at https://openrouter.ai/keys (no card needed).
# Note: the free tier caps :free models at ~20 requests/minute and 50
# requests/day — a ONE-TIME $10 credit purchase raises the daily cap to
# 1,000 (the credits never expire).
OPENROUTER_API_KEY=

# Optional: which OpenRouter models to try, in order (comma-separated).
# Default: openrouter/free (auto-routes to any available free model),
# nvidia/nemotron-3-super-120b-a12b:free, inclusionai/ling-3.0-flash-vl:free
# (a vision model, so photos still work). The free lineup rotates monthly —
# Llama/DeepSeek :free variants come and go — so when you want a specific
# one, check the live list (https://openrouter.ai/models → filter "Free")
# and set it here; retired models just 404 and get skipped.
# OPENROUTER_MODELS=

# Optional: override the main Gemini model
# (default: gemini-3.6-flash). If the main model is unavailable for your key
# OR hits its usage limit, the app automatically falls back to the models
# available in this project:
# gemini-3.1-flash-lite → antigravity → gemini-3.5-flash-lite → OpenRouter.
# GEMINI_MODEL=

# Optional: override the Gemini fallback order (comma-separated).
# "antigravity" is a Gemini *agent* (higher token use than a plain model) —
# drop it if you'd rather save tokens, e.g.:
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=

# Optional: how long a model is skipped after it hits its rate limit, before
# the app tries it again (seconds, default 300). Google's own retryDelay hint
# wins when the API sends one. Clamped to 15s–30min, doubles on repeat hits.
# GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=

# ── Accounts (sign in with Google) ──────────────────────────────────────────
# Auth.js secret — REQUIRED in production. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (create at https://console.cloud.google.com/apis/credentials,
# type "OAuth client ID" → "Web application", and add the redirect URI
# https://<your-domain>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Who's online (owner roster) ─────────────────────────────────────────────
# The account that signs in with this email is the OWNER: it gets a live
# "Who's online" roster (who has the app open, what they're looking at, and
# when everyone else was last seen). Every other account is a normal user and
# never sees the list. Comparison is case-insensitive; several addresses are
# allowed (comma-separated) — e.g. a personal + a work Google account.
# Leave it empty (or delete the line) to turn the feature off entirely.
# OWNER_EMAIL=you@example.com

# ── Maintenance mode ────────────────────────────────────────────────────────
# Set to 1 (or true/yes/on) to enable maintenance mode: signed-out visitors
# get a server-rendered "we'll be right back" page, while signed-in users
# keep full access and see a maintenance banner. Read at request time, so
# toggling it only needs a server restart — no rebuild.
# MAINTENANCE_MODE=
